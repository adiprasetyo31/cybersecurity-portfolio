---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner mono">
    <span>© {year} Adi Prasetyo</span>
    <span>Last updated Nov 2026</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .footer__inner {
    padding-block: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    font-size: 12px;
    color: var(--subtle);
  }
</style>
