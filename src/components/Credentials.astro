---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const creds = await getCollection('credentials');
const rooms = await getCollection('rooms');
---

<section id="certs" class="bordered">
  <div class="container section">
    <SectionHead eyebrow="05 / Credentials" title="Certifications and paths">
      <a href="https://tryhackme.com/p/adpstyo" target="_blank" rel="noopener" class="btn btn-ghost creds__thm">
        TryHackMe profile
      </a>
    </SectionHead>

    <div class="creds hairline-grid" data-reveal>
      {
        creds.map(({ data: c }) => (
          <div class="cred">
            <span class="label">{c.issuer}</span>
            <span class="cred__name">{c.name}</span>
            <span class:list={['cred__status mono', { 'cred__status--live': c.inProgress }]}>
              {c.inProgress && <span class="dot" />}
              {c.status}
            </span>
          </div>
        ))
      }
    </div>

    <div class="rooms">
      <span class="label">Rooms completed, by topic</span>
      <div class="rooms__grid" data-reveal>
        {
          rooms.map(({ data: r }) => (
            <div class="room">
              <span class="room__topic">{r.topic}</span>
              <span class="room__list">{r.rooms}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .creds__thm {
    min-height: 44px;
    font-size: 14px;
  }
  .creds {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .cred {
    padding: 28px;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .cred__name {
    font-size: 18px;
    font-weight: 500;
  }
  .cred__status {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: 12px;
    color: var(--subtle);
  }
  .cred__status--live {
    color: var(--text-2);
  }
  .rooms {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-top: var(--s-8);
  }
  .rooms__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    column-gap: var(--s-7);
    border-top: 1px solid var(--line);
  }
  .room {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .room__topic {
    flex: 0 0 140px;
    font-weight: 500;
    font-size: 15px;
  }
  .room__list {
    flex: 1 1 200px;
    min-width: 0;
    color: var(--subtle);
    font-size: 14px;
  }
</style>
