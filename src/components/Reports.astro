---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const reports = await getCollection('reports');
---

<section id="reports" class="bordered">
  <div class="container section">
    <SectionHead
      eyebrow="03 / Write-ups"
      title="Lab reports"
      desc="One page each: scope, findings, remediation. Screenshots are sanitised, no flags or secrets."
    />
    <div class="reports" data-reveal>
      {
        reports.map(({ data: r }) => (
          <a class="report" href={r.href} target="_blank" rel="noopener">
            <span class="report__file mono">{r.file}</span>
            <span class="report__role">{r.role}</span>
            <span class="report__date mono">{r.date}</span>
            <span class="report__cta">
              PDF
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 3v8M4 7l4 4 4-4M3 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reports {
    border-top: 1px solid var(--line);
  }
  .report {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    padding: var(--s-5) var(--s-2);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s ease;
  }
  .report:hover {
    background: var(--hover);
  }
  .report__file {
    flex: 2 1 340px;
    min-width: 0;
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .report__role {
    flex: 1 1 160px;
    color: var(--subtle);
    font-size: 14px;
  }
  .report__date {
    color: var(--subtle);
    font-size: 13px;
  }
  .report__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: 14px;
    font-weight: 500;
  }
</style>
