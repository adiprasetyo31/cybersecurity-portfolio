---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#reports', label: 'Reports' },
  { href: '#toolkit', label: 'Toolkit' },
  { href: '#certs', label: 'Credentials' },
  { href: '#log', label: 'Log' },
];
---

<header class="nav">
  <nav class="container nav__inner" aria-label="Main">
    <a href="#top" class="nav__brand">
      <span class="nav__mark mono">AP</span>
      <span>Adi Prasetyo</span>
    </a>
    <div class="nav__links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <a href="#contact" class="nav__cta">Get in touch</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(11, 13, 16, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .nav__mark {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    font-size: 12px;
  }
  .nav__links {
    display: flex;
    gap: var(--s-6);
    font-size: 14px;
  }
  .nav__links a {
    color: var(--subtle);
    transition: color 0.2s ease;
  }
  .nav__links a:hover {
    color: var(--text);
  }
  .nav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s-4);
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
  }
  .nav__cta:hover {
    color: var(--bg);
    background: #fff;
  }
  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
  }
</style>
