---
const contacts = [
  { label: 'Email', value: 'adpstyo@gmail.com', href: 'mailto:adpstyo@gmail.com' },
  { label: 'LinkedIn', value: 'in/adi-prasetyo', href: 'https://www.linkedin.com/in/adi-prasetyo-145446279/' },
  { label: 'GitHub', value: 'adiprasetyo31', href: 'https://github.com/adiprasetyo31' },
  { label: 'TryHackMe', value: 'adpstyo', href: 'https://tryhackme.com/p/adpstyo' },
];
---

<section id="contact" class="bordered">
  <div class="container contact">
    <span class="eyebrow">07 / Contact</span>
    <h2 class="contact__title" data-reveal>Hiring for an entry-level cybersecurity role? Let's talk.</h2>
    <p class="contact__sub" data-reveal>
      SOC, security support or analyst roles, full-time or internship. Night and weekend shifts are
      fine.
    </p>
    <div class="contact__grid hairline-grid" data-reveal>
      {
        contacts.map((c) => (
          <a
            class="tile"
            href={c.href}
            {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="tile__text">
              <span class="label">{c.label}</span>
              <span class="tile__value">{c.value}</span>
            </span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-top: 144px;
    padding-bottom: var(--s-9);
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }
  .contact__title {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 500;
    max-width: 16ch;
  }
  .contact__sub {
    max-width: 52ch;
    font-size: 18px;
    color: var(--muted);
  }
  .contact__grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .tile {
    padding: var(--s-5);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-3);
    color: var(--subtle);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tile:hover {
    background: var(--surface);
    color: var(--accent);
  }
  .tile svg {
    flex: 0 0 auto;
    margin-top: 4px;
  }
  .tile__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .tile__value {
    color: var(--text);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
</style>
